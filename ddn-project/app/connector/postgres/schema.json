{
  // === ROOT LEVEL ===
  // 1. Schema Definition
  "$schema": "http://json-schema.org/draft-07/schema#",  // Uses JSON Schema draft-07 for validation
  "title": "ParsedConfiguration",                       // Human-readable title
  "description": "Initial configuration to connect to a database and generate a full 'Configuration'.", // Purpose
  "type": "object",                                    // Top-level must be a JSON object
  "required": ["version"],                             // "version" is mandatory
  "properties": {                                      // Configurable properties
    // --- VERSION ---
    "version": {
      "$ref": "#/definitions/Version"  // Must match the "Version" definition (only allows "5")
    },
    // --- SCHEMA REFERENCE (OPTIONAL) ---
    "$schema": {
      "description": "JSON Schema of the configuration format.",
      "default": null,                 // Default is null (not required)
      "type": ["string", "null"]       // Can be a string (URL) or null
    },
    // --- DATABASE CONNECTION SETTINGS ---
    "connectionSettings": {
      "description": "Database connection settings.",
      "default": {                     // Default values if not provided
        "connectionUri": {
          "variable": "CONNECTION_URI" // Default: Read from env var `CONNECTION_URI`
        },
        "poolSettings": {              // Connection pool defaults
          "maxConnections": 50,        // Max connections in pool
          "poolTimeout": 30,           // Timeout (seconds) to get a connection
          "idleTimeout": 180,          // Idle connections closed after 180s
          "checkConnectionAfterIdle": 60, // Validate connections after 60s idle
          "connectionLifetime": 600     // Max connection lifetime (600s)
        },
        "isolationLevel": "ReadCommitted" // Default transaction isolation level
      },
      "allOf": [  // Must match the structure defined in "DatabaseConnectionSettings"
        { "$ref": "#/definitions/DatabaseConnectionSettings" }
      ]
    },
    // --- METADATA (TABLES, TYPES, OPERATIONS) ---
    "metadata": {
      "description": "Connector metadata.",
      "default": {                     // Default empty metadata
        "tables": {},                  // No tables defined by default
        "types": {                     // No custom types
          "scalar": {},
          "composite": {}
        },
        "nativeOperations": {          // No custom SQL queries/mutations
          "queries": {},
          "mutations": {}
        }
      },
      "allOf": [
        { "$ref": "#/definitions/Metadata" }  // Must match this structure
      ]
    },
    // --- INTROSPECTION OPTIONS ---
    "introspectionOptions": {
      "description": "Database introspection options.",
      "default": {                     // Default introspection rules
        "excludedSchemas": [           // Schemas to ignore
          "information_schema",         // PostgreSQL system schemas
          "pg_catalog",
          "tiger",                     // PostGIS schema
          "crdb_internal",             // CockroachDB internal
          "columnar",                  // Citus extension
          "columnar_internal"
        ],
        "unqualifiedSchemasForTables": ["public"],  // Tables in `public` don't need schema prefix
        "unqualifiedSchemasForTypesAndProcedures": [  // Types/procedures without prefix
          "public",
          "pg_catalog",  // Built-in PostgreSQL types
          "tiger"        // PostGIS
        ],
        // How SQL operators map to API filters (e.g., `=` → `_eq`)
        "comparisonOperatorMapping": [
          {
            "operatorName": "=",       // SQL operator
            "exposedName": "_eq",      // GraphQL filter name
            "operatorKind": "equal"    // Type of operator
          },
          // ... other operators (_like, _regex, etc.) ...
        ],
        // Special functions to treat as operators (e.g., PostGIS functions)
        "introspectPrefixFunctionComparisonOperators": [
          "box_above",                // Geometric operators
          "st_contains",              // PostGIS function
          // ... other functions ...
        ],
        // How database types map to API types
        "typeRepresentations": {
          "bit": "string",            // SQL `bit` → API `string`
          "bool": "boolean",          // SQL `bool` → API `boolean`
          "uuid": "uUID",             // SQL `uuid` → API `uUID`
          // ... other types ...
        }
      },
      "allOf": [
        { "$ref": "#/definitions/IntrospectionOptions" }  // Must match this structure
      ]
    },
    // --- MUTATIONS VERSION ---
    "mutationsVersion": {
      "description": "Which version of mutations to include (v1 or v2).",
      "default": null,                 // No default (must be explicitly set)
      "anyOf": [                      // Can be either:
        { "$ref": "#/definitions/MutationsVersion" },  // "v1" or "v2"
        { "type": "null" }            // Or omitted (null)
      ]
    },
    // --- MUTATIONS PREFIX ---
    "mutationsPrefix": {
      "description": "Custom prefix for mutation names (defaults to mutationsVersion).",
      "default": null,                 // No prefix by default
      "type": ["string", "null"]       // Can be a string (e.g., "custom_") or null
    }
  },
  // === DEFINITIONS (REUSABLE COMPONENTS) ===
  "definitions": {
    // --- VERSION ---
    "Version": {
      "type": "string",                // Must be a string
      "enum": ["5"]                    // Only allowed value is "5"
    },
    // --- DATABASE CONNECTION SETTINGS ---
    "DatabaseConnectionSettings": {
      "description": "Database connection settings.",
      "type": "object",
      "required": ["connectionUri"],   // Must have a connection URI
      "properties": {
        "connectionUri": {             // URI to connect to the database
          "description": "Postgres connection string or env var.",
          "allOf": [
            { "$ref": "#/definitions/ConnectionUri" }  // Must match this definition
          ]
        },
        "poolSettings": {              // Connection pool settings
          "description": "Connection pool configuration.",
          "default": {                 // Default values
            "maxConnections": 50,
            "poolTimeout": 30,
            "idleTimeout": 180,
            "checkConnectionAfterIdle": 60,
            "connectionLifetime": 600
          },
          "allOf": [
            { "$ref": "#/definitions/PoolSettings" }  // Must match this structure
          ]
        },
        "isolationLevel": {            // Transaction isolation level
          "description": "SQL transaction isolation level.",
          "default": "ReadCommitted",  // Default: ReadCommitted
          "allOf": [
            { "$ref": "#/definitions/IsolationLevel" }  // Must be valid
          ]
        }
      }
    },
    // --- CONNECTION URI (SECRET HANDLING) ---
    "ConnectionUri": {
      "$ref": "#/definitions/Secret"   // Can be a string or env var reference
    },
    "Secret": {                        // Defines how secrets are handled
      "anyOf": [                       // Either:
        { "type": "string" },          // Direct string (e.g., "postgresql://user:pass@host")
        {                              // Or an env var reference
          "type": "object",
          "required": ["variable"],
          "properties": {
            "variable": {              // Name of the env var (e.g., "DB_URL")
              "$ref": "#/definitions/Variable"
            }
          }
        }
      ]
    },
    "Variable": {                      // Environment variable name
      "description": "Name of an env var (e.g., 'DATABASE_URL').",
      "type": "string"
    },
    // --- POOL SETTINGS ---
    "PoolSettings": {
      "description": "PostgreSQL connection pool settings.",
      "type": "object",
      "properties": {
        "maxConnections": {            // Max connections in pool
          "description": "Max pool connections.",
          "default": 50,
          "type": "integer",
          "minimum": 0                 // Cannot be negative
        },
        "poolTimeout": {              // Timeout to get a connection
          "description": "Timeout (seconds) to acquire a connection.",
          "default": 30,
          "type": "integer",
          "minimum": 0
        },
        // ... (similar for idleTimeout, checkConnectionAfterIdle, etc.) ...
      }
    },
    // --- ISOLATION LEVEL ---
    "IsolationLevel": {
      "description": "SQL transaction isolation level.",
      "oneOf": [                       // Must be one of these:
        {
          "description": "Default: No dirty reads.",
          "type": "string",
          "enum": ["ReadCommitted"]    // Prevents uncommitted reads
        },
        {
          "description": "Guarantees repeatable reads.",
          "type": "string",
          "enum": ["RepeatableRead"]   // Same query → same result
        },
        {
          "description": "Highest isolation (serializable).",
          "type": "string",
          "enum": ["Serializable"]     // Transactions appear serialized
        }
      ]
    },
    // --- METADATA STRUCTURE ---
    "Metadata": {
      "description": "Database metadata (tables, types, operations).",
      "type": "object",
      "properties": {
        "tables": {                    // Table definitions
          "default": {},
          "allOf": [
            { "$ref": "#/definitions/TablesInfo" }  // Must match this
          ]
        },
        "types": {                     // Custom scalar/composite types
          "default": { "scalar": {}, "composite": {} },
          "allOf": [
            { "$ref": "#/definitions/Types" }
          ]
        },
        "nativeOperations": {          // Custom SQL queries/mutations
          "default": { "queries": {}, "mutations": {} },
          "allOf": [
            { "$ref": "#/definitions/NativeOperations" }
          ]
        }
      }
    },
    // --- TABLES INFO ---
    "TablesInfo": {
      "description": "Mapping of table names to their definitions.",
      "type": "object",
      "additionalProperties": {        // Dynamic keys (table names)
        "$ref": "#/definitions/TableInfo"  // Must match TableInfo structure
      }
    },
    // --- TABLE INFO ---
    "TableInfo": {
      "description": "Structure of a database table.",
      "type": "object",
      "required": ["schemaName", "tableName", "columns"],  // Required fields
      "properties": {
        "schemaName": { "type": "string" },   // Schema (e.g., "public")
        "tableName": { "type": "string" },    // Table name (e.g., "users")
        "columns": {                          // Column definitions
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ColumnInfo"  // Each column must match this
          }
        },
        "uniquenessConstraints": {            // Unique keys
          "default": {},
          "allOf": [
            { "$ref": "#/definitions/UniquenessConstraints" }
          ]
        },
        "foreignRelations": {                 // Foreign keys
          "default": {},
          "allOf": [
            { "$ref": "#/definitions/ForeignRelations" }
          ]
        },
        "description": {                      // Optional table description
          "default": null,
          "type": ["string", "null"]
        }
      }
    },
    // --- COLUMN INFO ---
    "ColumnInfo": {
      "description": "Structure of a table column.",
      "type": "object",
      "required": ["name", "type"],           // Must have name and type
      "properties": {
        "name": { "type": "string" },         // Column name
        "type": { "$ref": "#/definitions/Type" },  // Data type
        "nullable": {                         // Nullable?
          "default": "nullable",              // Default: nullable
          "allOf": [
            { "$ref": "#/definitions/Nullable" }  // Must be "nullable" or "nonNullable"
          ]
        },
        // ... (similar for hasDefault, isIdentity, etc.) ...
      }
    },
    // --- TYPE DEFINITIONS ---
    "Type": {
      "description": "Data type (scalar, composite, or array).",
      "oneOf": [                              // Must be one of:
        {                                      // Scalar type (e.g., "text")
          "type": "object",
          "required": ["scalarType"],
          "properties": {
            "scalarType": { "type": "string" }  // e.g., "uuid", "int4"
          }
        },
        {                                      // Composite type (custom)
          "type": "object",
          "required": ["compositeType"],
          "properties": {
            "compositeType": { "type": "string" }
          }
        },
        {                                      // Array type (e.g., "text[]")
          "type": "object",
          "required": ["arrayType"],
          "properties": {
            "arrayType": { "$ref": "#/definitions/Type" }  // Nested type
          }
        }
      ]
    },
    // --- NULLABLE ---
    "Nullable": {
      "description": "Whether a column allows NULL values.",
      "type": "string",
      "enum": ["nullable", "nonNullable"]     // Only these two options
    },
    // --- UNIQUENESS CONSTRAINTS ---
    "UniquenessConstraints": {
      "description": "Unique constraints (e.g., primary keys).",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/UniquenessConstraint"  // List of columns
      }
    },
    "UniquenessConstraint": {
      "description": "Columns forming a unique constraint.",
      "type": "array",
      "items": { "type": "string" },          // Column names
      "uniqueItems": true                     // No duplicates
    },
    // --- FOREIGN RELATIONS ---
    "ForeignRelations": {
      "description": "Foreign key constraints.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/ForeignRelation"  // Defines relationships
      }
    },
    "ForeignRelation": {
      "description": "Links between tables.",
      "type": "object",
      "required": ["foreignTable", "columnMapping"],  // Required fields
      "properties": {
        "foreignSchema": { "type": ["string", "null"] },  // Schema of target table
        "foreignTable": { "type": "string" },        // Target table name
        "columnMapping": {                           // Column mappings
          "type": "object",
          "additionalProperties": { "type": "string" }  // e.g., {"user_id": "id"}
        }
      }
    },
    // --- SCALAR & COMPOSITE TYPES ---
    "Types": {
      "description": "Custom scalar and composite types.",
      "type": "object",
      "required": ["scalar", "composite"],    // Must have both
      "properties": {
        "scalar": {                           // Scalar types (e.g., "uuid")
          "$ref": "#/definitions/ScalarTypes"
        },
        "composite": {                        // Custom object types
          "$ref": "#/definitions/CompositeTypes"
        }
      }
    },
    // --- SCALAR TYPES ---
    "ScalarTypes": {
      "description": "Map of scalar types (e.g., 'text', 'int4').",
      "type": "object",
      "additionalProperties": {               // Dynamic keys (type names)
        "$ref": "#/definitions/ScalarType"    // Must match ScalarType
      }
    },
    "ScalarType": {
      "description": "Properties of a scalar type.",
      "type": "object",
      "required": [                           // Required fields:
        "typeName",                           // e.g., "text"
        "schemaName",                         // e.g., "pg_catalog"
        "aggregateFunctions",                 // Supported aggregates (min/max)
        "comparisonOperators"                 // Supported operators (=, >)
      ],
      "properties": {
        "typeName": { "type": "string" },     // Type name
        "schemaName": { "type": "string" },   // Schema it belongs to
        "description": { "type": ["string", "null"] },  // Optional docs
        "aggregateFunctions": {               // Aggregates (e.g., "sum")
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/AggregateFunction"  // e.g., { "returnType": "int8" }
          }
        },
        "comparisonOperators": {              // Operators (e.g., "_eq")
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ComparisonOperator"  // Defines behavior
          }
        },
        "typeRepresentation": {               // How to represent in API
          "anyOf": [
            { "$ref": "#/definitions/TypeRepresentation" },  // e.g., "string"
            { "type": "null" }                // Or undefined
          ]
        }
      }
    },
    // --- AGGREGATE FUNCTIONS ---
    "AggregateFunction": {
      "type": "object",
      "required": ["returnType"],             // Must specify return type
      "properties": {
        "returnType": { "type": "string" }    // e.g., "float8" for AVG
      }
    },
    // --- COMPARISON OPERATORS ---
    "ComparisonOperator": {
      "description": "Defines a filter operator (e.g., _eq, _gt).",
      "type": "object",
      "required": ["operatorName", "operatorKind", "argumentType"],
      "properties": {
        "operatorName": { "type": "string" },  // SQL name (e.g., "=")
        "operatorKind": {                      // Type of operator
          "$ref": "#/definitions/OperatorKind"  // "equal", "in", or "custom"
        },
        "argumentType": { "type": "string" },  // Input type (e.g., "text")
        "isInfix": {                           // Is it infix (e.g., `a = b`)?
          "default": true,                     // Default: yes
          "type": "boolean"
        }
      }
    },
    // --- OPERATOR KIND ---
    "OperatorKind": {
      "description": "Category of operator.",
      "type": "string",
      "enum": ["equal", "in", "custom"]       // Only these 3 options
    },
    // --- TYPE REPRESENTATION ---
    "TypeRepresentation": {
      "description": "How a type is exposed in the API.",
      "oneOf": [                              // Must be one of these:
        { "type": "string", "enum": ["boolean"] },  // e.g., for `bool`
        { "type": "string", "enum": ["string"] },   // e.g., for `text`
        // ... (other mappings like int32, float64, etc.) ...
      ]
    },
    // --- COMPOSITE TYPES ---
    "CompositeTypes": {
      "description": "Custom object types (e.g., JSONB structures).",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/CompositeType"  // Must match this structure
      }
    },
    "CompositeType": {
      "description": "A custom type with fields (like a table).",
      "type": "object",
      "required": ["typeName", "schemaName", "fields"],
      "properties": {
        "typeName": { "type": "string" },     // Type name
        "schemaName": { "type": "string" },   // Schema it belongs to
        "fields": {                           // Field definitions
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/FieldInfo"  // Each field must match this
          }
        },
        "description": {                      // Optional docs
          "default": null,
          "type": ["string", "null"]
        }
      }
    },
    // --- FIELD INFO ---
    "FieldInfo": {
      "description": "A field in a composite type.",
      "type": "object",
      "required": ["fieldName", "type"],      // Must have name and type
      "properties": {
        "fieldName": { "type": "string" },    // Field name
        "type": { "$ref": "#/definitions/Type" },  // Data type
        "description": {                      // Optional docs
          "default": null,
          "type": ["string", "null"]
        }
      }
    },
    // --- NATIVE OPERATIONS ---
    "NativeOperations": {
      "description": "Custom SQL queries/mutations.",
      "type": "object",
      "required": ["queries", "mutations"],   // Must have both
      "properties": {
        "queries": {                         // Read-only SQL
          "description": "Custom queries.",
          "allOf": [
            { "$ref": "#/definitions/NativeQueries" }
          ]
        },
        "mutations": {                       // Write operations
          "description": "Custom mutations.",
          "allOf": [
            { "$ref": "#/definitions/NativeMutations" }
          ]
        }
      }
    },
    // --- NATIVE QUERIES ---
    "NativeQueries": {
      "description": "Map of custom SQL queries.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/NativeQueryInfo"  // Each query must match this
      }
    },
    "NativeQueryInfo": {
      "description": "A custom SQL query.",
      "type": "object",
      "required": ["sql", "columns"],         // Must have SQL and columns
      "properties": {
        "sql": {                              // SQL template
          "description": "SQL with variables like `{{name}}`.",
          "allOf": [
            { "$ref": "#/definitions/NativeQuerySql" }
          ]
        },
        "columns": {                          // Output columns
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ReadOnlyColumnInfo"  // Column structure
          }
        },
        "arguments": {                        // Input parameters
          "default": {},
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ReadOnlyColumnInfo"
          }
        },
        "description": {                      // Optional docs
          "default": null,
          "type": ["string", "null"]
        }
      }
    },
    // --- NATIVE SQL ---
    "NativeQuerySql": {
      "description": "SQL for a custom query.",
      "anyOf": [                              // Can be:
        {                                      // Reference to a file
          "type": "object",
          "required": ["file"],
          "properties": {
            "file": { "type": "string" }      // Path to .sql file
          }
        },
        {                                      // Or inline SQL
          "type": "object",
          "required": ["inline"],
          "properties": {
            "inline": { "$ref": "#/definitions/InlineNativeQuerySql" }
          }
        },
        { "$ref": "#/definitions/InlineNativeQuerySql" }  // Direct string
      ]
    },
    "InlineNativeQuerySql": {
      "type": "string"                        // Raw SQL string
    },
    // --- READ-ONLY COLUMN ---
    "ReadOnlyColumnInfo": {
      "description": "Column in a query result (no writes).",
      "type": "object",
      "required": ["name", "type"],          // Must have name and type
      "properties": {
        "name": { "type": "string" },        // Column name
        "type": { "$ref": "#/definitions/Type" },  // Data type
        "nullable": {                        // Nullable?
          "default": "nullable",
          "allOf": [
            { "$ref": "#/definitions/Nullable" }
          ]
        },
        "description": {                     // Optional docs
          "default": null,
          "type": ["string", "null"]
        }
      }
    },
    // --- NATIVE MUTATIONS ---
    "NativeMutations": {
      "description": "Map of custom write operations.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/NativeQueryInfo"  // Same structure as queries
      }
    },
    // --- INTROSPECTION OPTIONS ---
    "IntrospectionOptions": {
      "description": "Rules for database introspection.",
      "type": "object",
      "properties": {
        "excludedSchemas": {                 // Schemas to ignore
          "description": "System schemas to exclude.",
          "default": ["information_schema", "pg_catalog"],
          "type": "array",
          "items": { "type": "string" }
        },
        "unqualifiedSchemasForTables": {     // Tables without schema prefix
          "description": "Schemas where table names are unqualified.",
          "default": ["public"],
          "type": "array",
          "items": { "type": "string" }
        },
        // ... (other introspection options) ...
      }
    },
    // --- COMPARISON OPERATOR MAPPING ---
    "ComparisonOperatorMapping": {
      "description": "Maps SQL operators to API filters.",
      "type": "object",
      "required": ["operatorName", "exposedName", "operatorKind"],
      "properties": {
        "operatorName": { "type": "string" },  // SQL operator (e.g., "~")
        "exposedName": { "type": "string" },   // API name (e.g., "_regex")
        "operatorKind": {                      // "equal", "in", or "custom"
          "$ref": "#/definitions/OperatorKind"
        }
      }
    },
    // --- TYPE REPRESENTATIONS ---
    "TypeRepresentations": {
      "description": "How database types map to API types.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/TypeRepresentation"  // e.g., "text" → "string"
      }
    },
    // --- MUTATIONS VERSION ---
    "MutationsVersion": {
      "description": "Version of the mutations API.",
      "type": "string",
      "enum": ["v1", "v2"]                   // Only these two options
    }
  }
}
