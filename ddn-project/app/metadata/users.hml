---
kind: ObjectType
version: v1
definition:
  name: users
  fields:
    - name: created_at
      type: timestamptz!
    - name: customer_id
      type: text!
    - name: email
      type: text!
    - name: first_name
      type: text
    - name: id
      type: uuid!
    - name: last_name
      type: text
    - name: max_project_limit
      type: int4
    - name: organization_id
      type: text
    - name: updated_at
      type: timestamptz!
    - name: zendesk_user_id
      type: int4
  graphql:
    typeName: users
    inputTypeName: users_input
  dataConnectorTypeMapping:
    - dataConnectorName: postgres
      dataConnectorObjectType: users

---
kind: TypePermissions
version: v1
definition:
  typeName: users
  permissions:
    - role: admin
      output:
        allowedFields:
          - created_at
          - customer_id
          - email
          - first_name
          - id
          - last_name
          - max_project_limit
          - organization_id
          - updated_at
          - zendesk_user_id

---
kind: BooleanExpressionType
version: v1
definition:
  name: users_bool_exp
  operand:
    object:
      type: users
      comparableFields:
        - fieldName: created_at
          booleanExpressionType: timestamptz_bool_exp
        - fieldName: customer_id
          booleanExpressionType: text_bool_exp
        - fieldName: email
          booleanExpressionType: text_bool_exp
        - fieldName: first_name
          booleanExpressionType: text_bool_exp
        - fieldName: id
          booleanExpressionType: uuid_bool_exp
        - fieldName: last_name
          booleanExpressionType: text_bool_exp
        - fieldName: max_project_limit
          booleanExpressionType: int4_bool_exp
        - fieldName: organization_id
          booleanExpressionType: text_bool_exp
        - fieldName: updated_at
          booleanExpressionType: timestamptz_bool_exp
        - fieldName: zendesk_user_id
          booleanExpressionType: int4_bool_exp
      comparableRelationships:
        - relationshipName: invoices
        - relationshipName: projects
  logicalOperators:
    enable: true
  isNull:
    enable: true
  graphql:
    typeName: users_bool_exp

---
kind: AggregateExpression
version: v1
definition:
  name: users_agg_exp
  operand:
    object:
      aggregatedType: users
      aggregatableFields:
        - fieldName: created_at
          aggregateExpression: timestamptz_agg_exp
        - fieldName: customer_id
          aggregateExpression: text_agg_exp
        - fieldName: email
          aggregateExpression: text_agg_exp
        - fieldName: first_name
          aggregateExpression: text_agg_exp
        - fieldName: id
          aggregateExpression: uuid_agg_exp
        - fieldName: last_name
          aggregateExpression: text_agg_exp
        - fieldName: max_project_limit
          aggregateExpression: int4_agg_exp
        - fieldName: organization_id
          aggregateExpression: text_agg_exp
        - fieldName: updated_at
          aggregateExpression: timestamptz_agg_exp
        - fieldName: zendesk_user_id
          aggregateExpression: int4_agg_exp
  count:
    enable: true
  graphql:
    selectTypeName: users_agg_exp

---
kind: OrderByExpression
version: v1
definition:
  name: users_order_by_exp
  operand:
    object:
      orderedType: users
      orderableFields:
        - fieldName: created_at
          orderByExpression: timestamptz_order_by_exp
        - fieldName: customer_id
          orderByExpression: text_order_by_exp
        - fieldName: email
          orderByExpression: text_order_by_exp
        - fieldName: first_name
          orderByExpression: text_order_by_exp
        - fieldName: id
          orderByExpression: uuid_order_by_exp
        - fieldName: last_name
          orderByExpression: text_order_by_exp
        - fieldName: max_project_limit
          orderByExpression: int4_order_by_exp
        - fieldName: organization_id
          orderByExpression: text_order_by_exp
        - fieldName: updated_at
          orderByExpression: timestamptz_order_by_exp
        - fieldName: zendesk_user_id
          orderByExpression: int4_order_by_exp
      orderableRelationships: []
  graphql:
    expressionTypeName: users_order_by_exp

---
kind: Model
version: v2
definition:
  name: users
  objectType: users
  source:
    dataConnectorName: postgres
    collection: users
  filterExpressionType: users_bool_exp
  aggregateExpression: users_agg_exp
  orderByExpression: users_order_by_exp
  graphql:
    selectMany:
      queryRootField: users
      subscription:
        rootField: users
    selectUniques:
      - queryRootField: users_by_customer_id
        uniqueIdentifier:
          - customer_id
        subscription:
          rootField: users_by_customer_id
      - queryRootField: users_by_id
        uniqueIdentifier:
          - id
        subscription:
          rootField: users_by_id
      - queryRootField: users_by_zendesk_user_id
        uniqueIdentifier:
          - zendesk_user_id
        subscription:
          rootField: users_by_zendesk_user_id
    filterInputTypeName: users_filter_input
    aggregate:
      queryRootField: users_aggregate
      subscription:
        rootField: users_aggregate

---
kind: ModelPermissions
version: v1
definition:
  modelName: users
  permissions:
    - role: admin
      select:
        filter: null
        allowSubscriptions: true

---
kind: Relationship
version: v1
definition:
  name: invoices
  sourceType: users
  target:
    model:
      name: invoice
      relationshipType: Array
      aggregate:
        aggregateExpression: invoice_agg_exp
  mapping:
    - source:
        fieldPath:
          - fieldName: customer_id
      target:
        modelField:
          - fieldName: customer_id
  graphql:
    aggregateFieldName: invoices_aggregate

---
kind: Relationship
version: v1
definition:
  name: projects
  sourceType: users
  target:
    model:
      name: projects
      relationshipType: Array
      aggregate:
        aggregateExpression: projects_agg_exp
  mapping:
    - source:
        fieldPath:
          - fieldName: id
      target:
        modelField:
          - fieldName: owner_id
  graphql:
    aggregateFieldName: projects_aggregate

